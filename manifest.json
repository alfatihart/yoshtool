{
  "manifest_version": 3,
  "name": "YoshTool",
  "version": "1.3.1",
  "description": "Export/import cookie dalam beberapa format, bersihkan cache halaman, dan tangkap screenshot.",
  "permissions": [
    "cookies",
    "activeTab",
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "browsingData",
    "scripting",
    "debugger",
    "downloads",
    "contextMenus"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Buka popup YoshTool"
    },
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+1", "mac": "Command+Shift+1" },
      "description": "Screenshot: Capture area"
    },
    "capture-screen": {
      "suggested_key": { "default": "Alt+Shift+2", "mac": "Command+Shift+2" },
      "description": "Screenshot: Capture screen area"
    },
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "Command+Shift+F" },
      "description": "Screenshot: Capture full page"
    },
    "fill-dummy": {
      "description": "Isi form dengan data dummy (atur shortcut di chrome://extensions/shortcuts)"
    }
  }
}
