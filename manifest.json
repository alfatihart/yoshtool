{
  "manifest_version": 3,
  "name": "YoshTool",
  "version": "1.37.1",
  "description": "Manage cookies/sessions (multi-login), clear cache, screenshots, Dev tools, auto-redact, an ad/tracker blocker, and a popup blocker.",
  "permissions": [
    "cookies",
    "activeTab",
    "alarms",
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "browsingData",
    "scripting",
    "debugger",
    "downloads",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": false, "path": "rule_resources/dnr-ads.json" },
      { "id": "trackers", "enabled": false, "path": "rule_resources/dnr-trackers.json" },
      { "id": "redirect", "enabled": false, "path": "rule_resources/dnr-redirect.json" },
      { "id": "paramstrip", "enabled": false, "path": "rule_resources/dnr-paramstrip.json" }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["rule_resources/cosmetics.json"],
      "matches": ["*://*/*"]
    },
    {
      "resources": ["rule_resources/redirects/*"],
      "matches": ["*://*/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Open the YoshTool popup"
    },
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+1", "mac": "Command+Shift+1" },
      "description": "Screenshot: Capture area"
    },
    "capture-screen": {
      "suggested_key": { "default": "Alt+Shift+2", "mac": "Command+Shift+2" },
      "description": "Screenshot: Capture screen area"
    },
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "Command+Shift+F" },
      "description": "Screenshot: Capture full page"
    },
    "fill-dummy": {
      "description": "Fill the form with dummy data (set a shortcut at chrome://extensions/shortcuts)"
    },
    "pick-element": {
      "description": "Block an element: pick on the page (set a shortcut at chrome://extensions/shortcuts)"
    },
    "zap-element": {
      "description": "Zap an element: remove once (set a shortcut at chrome://extensions/shortcuts)"
    },
    "edit-page": {
      "description": "Inspect & edit: pick an element to edit (set a shortcut at chrome://extensions/shortcuts)"
    },
    "reveal-password": {
      "description": "Show passwords: reveal password fields (set a shortcut at chrome://extensions/shortcuts)"
    }
  }
}
