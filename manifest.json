{
  "manifest_version": 3,
  "name": "YoshTool",
  "version": "1.0",
  "description": "Export/import cookie dalam beberapa format, bersihkan cache halaman, dan tangkap screenshot.",
  "permissions": [
    "cookies",
    "activeTab",
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "browsingData",
    "scripting",
    "debugger",
    "downloads"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
